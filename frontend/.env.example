# Copia este archivo como `.env.local` y rellena los valores.
# `.env.local` esta en .gitignore: nunca lo commitees.

# JWT firmado con la misma JWT_SECRET_KEY con la que corre FastAPI.
# Se genera con:  JWT_SECRET_KEY=... python generar_token.py
#
# ADVERTENCIA: Vite lo embebe en el bundle del navegador, asi que es visible
# para cualquiera que abra las herramientas de desarrollo. Solo para demos
# locales contra datos de prueba; desaparece cuando exista el BFF y el JWT
# pase a resolverse server-side desde la cookie de sesion.
VITE_DEMO_JWT=

# Credenciales de la fachada de demostracion (src/auth/DemoSessionProvider.ts).
# Opcionales: si no se definen, se usan los valores por defecto del codigo.
# Esto NO es autenticacion y no protege ningun dato.
VITE_DEMO_EMAIL=
VITE_DEMO_PASSWORD=
VITE_DEMO_ACTOR_ID=
